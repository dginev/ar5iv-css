{
  "name": "ar5iv-css",
  "version": "0.8.4",
  "description": "CSS theme for arXiv articles converted with LaTeXML",
  "main": "css/ar5iv.css",
  "style": "css/ar5iv.css",
  "sideEffects": [
    "css/ar5iv.css",
    "css/ar5iv-fonts.css",
    "css/ar5iv/*.css"
  ],
  "exports": {
    ".": "./css/ar5iv.css",
